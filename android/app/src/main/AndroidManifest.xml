<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating window overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Proactive signal sources -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- NPU inference needs wake lock for background processing -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Tool system: alarm/timer -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Internet for model download -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for context sensing -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Require Snapdragon NPU -->
    <uses-feature android:name="android.hardware.npu" android:required="false" />

    <application
        android:name=".AgentApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenSparX">

        <!-- Onboarding (first launch) -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:theme="@style/Theme.OpenSparX"
            android:exported="false" />

        <!-- Main entry point -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenSparX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Agent Panel (full screen DAG visualization) -->
        <activity
            android:name=".ui.AgentPanelActivity"
            android:theme="@style/Theme.OpenSparX" />

        <activity
            android:name=".ui.ModelLibraryActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="Model Library" />

        <activity
            android:name=".ui.NpuSetupActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="NPU Setup" />

        <activity
            android:name=".ui.PlanExecutionActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="Agent Planning" />

        <activity
            android:name=".ui.TechShowcaseActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="Technology Showcase" />

        <activity
            android:name=".ui.ArchitectureActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="System Architecture" />

        <activity
            android:name=".ui.ContextSensingActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="Context Sensing" />

        <activity
            android:name=".ui.CockpitAgentActivity"
            android:theme="@style/Theme.OpenSparX"
            android:label="Cockpit Agent"
            android:screenOrientation="portrait" />

        <!-- Floating widget service (desktop pet) -->
        <service
            android:name=".ui.FloatingAgentService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Chat bubble overlay service -->
        <service
            android:name=".ui.ChatBubbleService"
            android:exported="false" />

        <!-- Proactive context monitoring service -->
        <service
            android:name=".signal.ContextMonitorService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Notification listener for context signals -->
        <service
            android:name=".signal.NotificationSignalService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
