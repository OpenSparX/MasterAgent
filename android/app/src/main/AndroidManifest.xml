<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating window overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Proactive signal sources -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- NPU inference needs wake lock for background processing -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Require Snapdragon NPU -->
    <uses-feature android:name="android.hardware.npu" android:required="false" />

    <application
        android:name=".AgentApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenSparX">

        <!-- Main entry point -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenSparX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Agent Panel (full screen DAG visualization) -->
        <activity
            android:name=".ui.AgentPanelActivity"
            android:theme="@style/Theme.OpenSparX" />

        <!-- Floating widget service -->
        <service
            android:name=".ui.FloatingAgentService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Proactive context monitoring service -->
        <service
            android:name=".signal.ContextMonitorService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Notification listener for context signals -->
        <service
            android:name=".signal.NotificationSignalService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
