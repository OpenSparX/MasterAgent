<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Architecture"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenSparX Agent OS v0.1"
            android:textSize="14sp"
            android:textColor="#66FFFFFF"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp" />

        <!-- Layer 1: User Experience -->
        <LinearLayout
            android:id="@+id/layer_ux"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_arch_layer_1"
            android:padding="16dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#00E676" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Experience Layer"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat Bubble · Proactive Cards · DAG"
                    android:textSize="13sp"
                    android:textColor="#00E676"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_ux"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating overlay system with context-aware UI. The DAG visualizer renders live agent reasoning as a directed acyclic graph. Proactive cards surface actionable insights before the user asks."
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#33FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Layer 2: Agent Intelligence -->
        <LinearLayout
            android:id="@+id/layer_intelligence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_arch_layer_2"
            android:padding="16dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#00C853" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agent Intelligence Layer"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planning · Speculation · Verification"
                    android:textSize="13sp"
                    android:textColor="#00C853"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_intelligence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multi-step planning with speculative execution. The agent generates candidate action plans, executes them speculatively, and verifies outcomes before committing. Achieves 2.3x throughput via branch prediction on token sequences."
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#33FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Layer 3: Coordination -->
        <LinearLayout
            android:id="@+id/layer_coordination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_arch_layer_3"
            android:padding="16dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#00ACC1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coordination Layer"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mesh Protocol · CRDT · Discovery"
                    android:textSize="13sp"
                    android:textColor="#00ACC1"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_coordination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peer-to-peer agent mesh using CRDTs for conflict-free state synchronization. Automatic discovery of nearby agent instances. Enables multi-device collaboration without a central server."
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#33FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Layer 4: Inference Engine -->
        <LinearLayout
            android:id="@+id/layer_inference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_arch_layer_4"
            android:padding="16dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#1565C0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inference Engine Layer"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GenieX · llama.cpp · NPU/GPU/CPU"
                    android:textSize="13sp"
                    android:textColor="#42A5F5"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_inference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unified inference abstraction over Qualcomm GenieX SDK, llama.cpp, and vendor-specific accelerators. Automatic backend selection based on model format, hardware capability, and thermal state. Supports INT4/INT8/FP16 quantization."
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connector -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="#33FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Layer 5: Hardware Abstraction -->
        <LinearLayout
            android:id="@+id/layer_hardware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_arch_layer_5"
            android:padding="16dp"
            android:layout_marginBottom="2dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#0D47A1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware Abstraction"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qualcomm HTP · MediaTek APU · ARM"
                    android:textSize="13sp"
                    android:textColor="#5C6BC0"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/detail_hardware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HAL for heterogeneous compute across Qualcomm Hexagon Tensor Processor, MediaTek APU (NeuroPilot), and ARM CPU fallback. Dynamic dispatch based on thermal throttling, power budget, and operator support. JNI bridge to vendor SDKs."
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="20 Kotlin modules · 6 native libs · 3 strategic features"
            android:textSize="12sp"
            android:textColor="#4DFFFFFF"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
