<?xml version="1.0" encoding="utf-8"?>
<!-- Agent Panel — full-screen DAG visualization of agent thought process -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117"
    tools:context=".ui.AgentPanelActivity">

    <!-- DAG canvas fills the screen -->
    <com.opensparx.agent.ui.DagView
        android:id="@+id/dag_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: plan title + close button -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#CC0D1117">

        <TextView
            android:id="@+id/plan_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Agent Plan"
            android:textColor="#E6EDF3"
            android:textSize="16sp"
            android:fontFamily="monospace" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close panel"
            android:tint="#8B949E" />
    </LinearLayout>

    <!-- Bottom stats bar: NPU load, tok/s, KV cache -->
    <LinearLayout
        android:id="@+id/stats_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#CC0D1117">

        <TextView
            android:id="@+id/stat_npu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NPU: --"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/stat_toks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="tok/s: --"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/stat_kv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KV: --"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

</FrameLayout>
