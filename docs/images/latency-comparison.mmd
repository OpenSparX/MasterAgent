    style API fill:#ff8787,stroke:#f03e3e
    style Local fill:#51cf66,stroke:#37b24d
    style NPU fill:#38d9a9,stroke:#20c997
    style U1 fill:#ffd43b
    style U2 fill:#74c0fc

    Note1[Cloud: 2.5-5s total latency]
    Note2[Sparx: <100ms total latency]

    style Note1 fill:#ffe3e3,stroke:#c92a2a,stroke-dasharray: 5 5
    style Note2 fill:#d3f9e8,stroke:#37b24d,stroke-dasharray: 5 5
